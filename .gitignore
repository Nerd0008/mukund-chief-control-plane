# --- Secrets and credentials (never commit) ---
.env
.env.*
env.*
*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*
*credential*
*secret*
*token*
*cookie*
*password*
authorized_keys
known_hosts

# --- Explicit exception -------------------------------------------------------
# Gate/deployment tooling whose *filename* matches the credential patterns above
# but which contains no secret: it performs presence checks only and never reads
# a credential value. Without this negation the file is silently excluded from
# the control plane while being referenced by the deployment runbook.
!scripts/e3_credential_presence_probe.py

# --- Hermes databases / session state (raw data stays local) ---
*.db
*.sqlite
*.sqlite3
*.session
*session*
hermes/
conversations/raw/

# --- Caches / temp files ---
__pycache__/
.cache/
cache/
tmp/
temp/
*.tmp
*.temp
*.swp
*.bak
Thumbs.db
.DS_Store
node_modules/
.venv/
venv/
exec_brain.db
chain-head.json

# --- Company Watch: owner-private company-level job-search data ---
# The full company registry and per-posting findings name Mukund's historical
# application history. They stay local; only aggregate counts/evidence are
# committed to the shared control plane.
runtime/company-watch/

# --- CV / cover-letter drafts and LinkedIn runtime (owner-private) ---
# Generated CV/cover-letter drafts and LinkedIn signal intake carry the owner's
# own contact details, posting links and unsent draft text. Only aggregate
# evidence (audits/evidence/) is committed.
runtime/career-ops/cv-drafts/
runtime/linkedin/

# --- Application Inbox / Status Monitor: owner-private mailbox data ---
# Raw status signals, matched subjects/senders and proposed status changes name
# Mukund's employers, recruiters and application history. They stay local; only
# aggregate counts, hashes and check results are committed.
runtime/career-ops/application-status/
runtime/career-ops/application-inbox/
audits/evidence/**/status-store/

# --- Career Daily Brief runtime artifacts (owner-private) ---
# The brief restates job titles, companies, posting URLs, deadlines and owner
# actions, and its acceptance runs write their working copies under the same
# tree. Only `audits/evidence/<stamp>-career-daily-brief/` (aggregate counts,
# hashes and check results) is committed.
runtime/career-ops/daily-brief/
runtime/career-ops/daily-brief-*/

# --- Owner-private evidence artifacts (never committed) ---
# Raw tracker backups, raw ATS findings and raw resolution dumps name Mukund's
# companies, postings and application history. Committed evidence stays
# aggregate (counts, hashes, verification results).
audits/evidence/**/backups/*.xlsx
audits/evidence/**/findings.json
audits/evidence/**/resolution.json
audits/evidence/**/manifest-*.json

# --- Deployment backup/restore drill: raw snapshots must never be committed ---
# The drill writes its snapshots to a scratch directory outside the repository;
# these patterns are defence in depth in case a drill is ever pointed at an
# evidence directory. Only the aggregate report (hashes, row counts) is kept.
audits/evidence/**/backup/
audits/evidence/**/restore-check/
